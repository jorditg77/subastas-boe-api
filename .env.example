# Puerto local de la aplicación
PORT=3000

# Interfaz de escucha. Por defecto 127.0.0.1: la API solo es accesible por el
# túnel de Cloudflare (mismo host), no desde otros equipos de la red local.
# Usa 0.0.0.0 solo si necesitas exponerla en la LAN (no recomendado).
HOST=127.0.0.1

# Modo: development | production
NODE_ENV=production

# Clave secreta para validar requests de RapidAPI. OBLIGATORIA en producción:
# el servidor se niega a arrancar con NODE_ENV=production sin ella, para no
# exponer la API sin autenticación tras el túnel. Genera una con:
#   openssl rand -hex 32
RAPIDAPI_PROXY_SECRET=tu_secreto_aqui

# Secretos de OTROS gateways/marketplaces (Zyla, etc.), separados por comas.
# Cada marketplace debe recibir su propio secreto (cabecera X-Gateway-Secret
# o X-RapidAPI-Proxy-Secret) para poder rotarlos por separado.
# GATEWAY_EXTRA_SECRETS=secreto_zyla,otro_secreto

# Cloudflare Tunnel no requiere configuración aquí; se ejecuta externamente con cloudflared
# Comando típico: cloudflared tunnel --no-autoupdate run --token <TOKEN>

# Límites de caché (MB). CACHE_MAX_MEMORY_MB acota el tamaño REAL en bytes
# de las entradas cacheadas (no un nº fijo de entradas), porque una subasta
# multi-lote con decenas de bienes pesa mucho más que una simple.
CACHE_MAX_MEMORY_MB=1500
CACHE_AUCTION_TTL_SECONDS=14400
CACHE_SEARCH_TTL_SECONDS=7200
CACHE_PROVINCES_TTL_SECONDS=86400
# Válvula de emergencia a nivel de proceso (heap total), no de la caché.
CACHE_MEMORY_PRESSURE_THRESHOLD_MB=2500

# Límites de scraping al BOE
BOE_MAX_CONCURRENT_REQUESTS=3
BOE_REQUEST_DELAY_MS=1000
BOE_RETRY_ATTEMPTS=3
BOE_RETRY_BACKOFF_MS=2000
# Timeout por petición al BOE (ms): evita que una conexión colgada bloquee un
# slot de concurrencia indefinidamente.
BOE_REQUEST_TIMEOUT_MS=20000

# Rate limit propio (techo de protección del servidor, por IP real). No
# sustituye a la cuota del marketplace. Holgado a propósito.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
